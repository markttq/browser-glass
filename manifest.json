{
  "manifest_version": 3,
  "name": "Browser Glass",
  "version": "0.9.0",
  "description": "Tahoe wallpaper and glass across your browser, with Markentum daily reading lessons on the new tab page.",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "wallpaper.js"
      ],
      "run_at": "document_start",
      "css": [
        "glass.css"
      ]
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://duckduckgo.com/*"
      ],
      "js": [
        "wallpaper.js"
      ],
      "run_at": "document_start",
      "css": [
        "duckduckgo.css"
      ]
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "wallpaper.js"
      ],
      "run_at": "document_start",
      "css": [
        "wallpaper-sites.css",
        "youtube.css"
      ]
    },
    {
      "matches": [
        "https://docs.docker.com/*"
      ],
      "js": [
        "wallpaper.js"
      ],
      "run_at": "document_start",
      "css": [
        "wallpaper-sites.css",
        "docker-docs.css"
      ]
    },
    {
      "matches": [
        "https://docker.com/*",
        "https://www.docker.com/*"
      ],
      "js": [
        "wallpaper.js"
      ],
      "run_at": "document_start",
      "css": [
        "wallpaper-sites.css",
        "docker.css"
      ]
    },
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "wallpaper.js"
      ],
      "run_at": "document_start",
      "css": [
        "wallpaper-sites.css",
        "github.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "tahoe-day.jpg"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://duckduckgo.com/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://docs.docker.com/*",
        "https://docker.com/*",
        "https://www.docker.com/*",
        "https://github.com/*"
      ]
    }
  ],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
