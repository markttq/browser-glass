{
  "manifest_version": 3,
  "name": "Browser Glass",
  "version": "0.8.15",
  "description": "Tahoe wallpaper for ChatGPT and DuckDuckGo search, with ChatGPT glass and reasoning shortcuts.",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "wallpaper.js"
      ],
      "run_at": "document_start",
      "css": [
        "glass.css"
      ]
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://duckduckgo.com/*"
      ],
      "js": [
        "wallpaper.js"
      ],
      "run_at": "document_start",
      "css": [
        "duckduckgo.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "tahoe-day.jpg"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://duckduckgo.com/*"
      ]
    }
  ]
}
