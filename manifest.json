{
  "manifest_version": 3,
  "name": "Browser Glass",
  "version": "0.8.27",
  "description": "Tahoe wallpaper and glass for ChatGPT, DuckDuckGo, YouTube, Docker, GitHub, and Google, with ChatGPT reasoning shortcuts.",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "wallpaper.js"
      ],
      "run_at": "document_start",
      "css": [
        "glass.css"
      ]
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://duckduckgo.com/*"
      ],
      "js": [
        "wallpaper.js"
      ],
      "run_at": "document_start",
      "css": [
        "duckduckgo.css"
      ]
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "wallpaper.js"
      ],
      "run_at": "document_start",
      "css": [
        "wallpaper-sites.css",
        "youtube.css"
      ]
    },
    {
      "matches": [
        "https://docs.docker.com/*"
      ],
      "js": [
        "wallpaper.js"
      ],
      "run_at": "document_start",
      "css": [
        "wallpaper-sites.css",
        "docker-docs.css"
      ]
    },
    {
      "matches": [
        "https://docker.com/*",
        "https://www.docker.com/*"
      ],
      "js": [
        "wallpaper.js"
      ],
      "run_at": "document_start",
      "css": [
        "wallpaper-sites.css",
        "docker.css"
      ]
    },
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "wallpaper.js"
      ],
      "run_at": "document_start",
      "css": [
        "wallpaper-sites.css",
        "github.css"
      ]
    },
    {
      "matches": [
        "https://google.com/*",
        "https://www.google.com/*"
      ],
      "js": [
        "wallpaper.js"
      ],
      "run_at": "document_start",
      "css": [
        "wallpaper-sites.css",
        "google.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "tahoe-day.jpg"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://duckduckgo.com/*",
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://docs.docker.com/*",
        "https://docker.com/*",
        "https://www.docker.com/*",
        "https://github.com/*",
        "https://google.com/*",
        "https://www.google.com/*"
      ]
    }
  ]
}
