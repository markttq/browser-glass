{
  "manifest_version": 3,
  "name": "ChatGPT Thinking Helper",
  "version": "0.8.7",
  "description": "Stable Tahoe glass theme with a boulder-free wallpaper and enhanced main-pane readability.",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "glass.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "tahoe-day.jpg"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ]
    }
  ]
}
